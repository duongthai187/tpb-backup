# Notify Service — Env vars
# Copy to .env and fill in real values

# ── Redis (S1) ────────────────────────────────────
REDIS_URL=redis://192.168.255.71:6379/0
STREAM_NAME=webhook:batches
DLQ_STREAM=notify:dlq
CONSUMER_GROUP=notify-telegram
CONSUMER_NAME=notifier-1

# ── Telegram ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Filter ────────────────────────────────────────
# Only notify these trans types (C=Credit, D=Debit)
NOTIFY_TYPES=C,D

# ── Tuning ────────────────────────────────────────
MAX_RETRIES=3
BATCH_SIZE=10
BLOCK_MS=5000
HEALTH_PORT=8080
